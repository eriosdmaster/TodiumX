{
  "name": "ExamplePlugin",
  "version": "1.0.0",
  "main": "ExamplePlugin\\Main",
  "api": "1.0.0",
  "description": "Example PHP plugin for TodiumX/RaspberryX",
  "author": "You",
  "commands": {
    "hello": {
      "description": "Says hello",
      "usage": "/hello",
      "permission": "example.hello"
